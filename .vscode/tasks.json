{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Diary: Backend (FastAPI)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "cd \"${workspaceFolder}\\server\"; if (!(Test-Path .venv)) { python -m venv .venv }; .\\.venv\\Scripts\\Activate.ps1; pip install -r requirements.txt; uvicorn main:app --host 0.0.0.0 --port 8787"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "diary-uvicorn",
        "pattern": [
          {
            "kind": "file",
            "regexp": "^(.*)$",
            "file": 1,
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Uvicorn running on"
        }
      }
    },
    {
      "label": "Diary: Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}\\diary-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "diary-vite",
        "pattern": [
          {
            "kind": "file",
            "regexp": "^(.*)$",
            "file": 1,
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:|Network:|ready in"
        }
      }
    },
    {
      "label": "Diary: Open Chrome",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Start-Process chrome.exe 'http://localhost:5173/'"
      ],
      "problemMatcher": []
    },
    {
      "label": "Diary: Start (Backend + Frontend + Chrome)",
      "dependsOrder": "sequence",
      "dependsOn": ["Diary: Backend (FastAPI)", "Diary: Frontend (Vite)", "Diary: Open Chrome"],
      "problemMatcher": []
    }
  ]
}
