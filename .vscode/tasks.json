{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Diary: Backend (FastAPI)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "cd \"${workspaceFolder}\"; if (!(Test-Path server\\.venv)) { python -m venv server\\.venv }; .\\server\\.venv\\Scripts\\Activate.ps1; pip install -r server\\requirements.txt; uvicorn server.main:app --host 0.0.0.0 --port 8787"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Diary: Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}\\diary-app"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Diary: Open Chrome",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Start-Sleep -Seconds 2; Start-Process chrome.exe 'http://localhost:5173/'"
      ],
      "problemMatcher": []
    },
    {
      "label": "Diary: Start (Backend + Frontend + Chrome)",
      "dependsOrder": "parallel",
      "dependsOn": ["Diary: Backend (FastAPI)", "Diary: Frontend (Vite)", "Diary: Open Chrome"],
      "problemMatcher": []
    }
  ]
}
