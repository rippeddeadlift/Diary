{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Diary: dev",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}\\diary-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [
          {
            "regexp": ".+"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "ready in|Local:"
        }
      }
    }
  ]
}
